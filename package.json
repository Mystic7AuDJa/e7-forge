{
  "name": "e7-forge",
  "productName": "E7 Forge",
  "version": "0.1.2",
  "description": "Personal Epic Seven gear optimizer: account-wide optimization, speed tuning, upgrade ROI, community benchmarks, stat recommendations and team building. Imports Fribbels optimizer exports.",
  "author": "E7 Forge contributors",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "npm run build && npx --yes electron-builder@26.18.0 --win dir --x64 && node scripts/set-exe-icon.mjs \"release/win-unpacked/E7 Forge.exe\""
  },
  "build": {
    "appId": "app.e7forge.desktop",
    "productName": "E7 Forge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "data/**",
      "!data/epic7db-skills.json",
      "capture/**",
      "package.json"
    ],
    "extraFiles": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "data/**",
      "capture/**",
      "dist-electron/worker.js",
      "dist-electron/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "cross-env": "7.0.3",
    "electron": "45.2.1",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resedit": "2.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "2.1.9",
    "wait-on": "8.0.5"
  }
}
